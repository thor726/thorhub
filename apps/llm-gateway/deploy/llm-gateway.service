[Unit]
Description=LLM Proxy Gateway (Express.js + SQLite, ThorHub)
Documentation=file:///root/project/apps/llm-gateway/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/project/apps/llm-gateway
EnvironmentFile=/root/project/apps/llm-gateway/.env
ExecStart=/root/.thor/tools/node-26.12.1-linux-x64/bin/node src/server.js
Restart=always
RestartSec=3

StandardOutput=journal
StandardError=journal
SyslogIdentifier=llm-gateway

LimitNOFILE=65535

KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
