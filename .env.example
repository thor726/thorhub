# ==============================================================
# LLM PROXY GATEWAY - KONFIGURASI
# Salin file ini menjadi ".env" lalu isi nilainya:
#   cp .env.example .env
# ==============================================================

# --------------------------------------------------------------
# SERVER
# --------------------------------------------------------------
# Port server gateway (default 3000)
PORT=3000

# --------------------------------------------------------------
# PROVIDER
# --------------------------------------------------------------
# Master API Key yang dipakai GATEWAY untuk memanggil provider utama.
# WAJIB diisi. JANGAN pernah dibagikan ke pembeli!
MASTER_API_KEY=sk-master-GANTI-DENGAN-KEY-ASLI-ANDA

# Base URL provider utama (tanpa trailing slash).
# Contoh OpenAI        : https://api.openai.com/v1
# Contoh OpenRouter    : https://openrouter.ai/api/v1
# Contoh Re:Link       : https://api.relink-gateway.biz.id/v1
# Sesuaikan dengan dokumentasi provider Anda.
TARGET_API_BASE_URL=https://api.openai.com/v1

# --------------------------------------------------------------
# ADMIN
# --------------------------------------------------------------
# API Key admin untuk REST API /admin/* (header: Authorization: Bearer ...)
# Dipakai oleh CLI/skrip/integrasi programatik.
ADMIN_API_KEY=admin-GANTI-SECRET-INI

# Password untuk login PANEL ADMIN WEB (/admin).
# Berbeda peran dari ADMIN_API_KEY di atas (boleh berbeda nilainya).
ADMIN_PASSWORD=password-panel-admin-GANTI-INI

# --------------------------------------------------------------
# TIMEOUT
# --------------------------------------------------------------
# Timeout antrean: pembeli menunggu giliran maksimal selama ini (ms)
QUEUE_WAIT_TIMEOUT_MS=60000

# Timeout request ke provider utama (ms)
UPSTREAM_TIMEOUT_MS=120000

# --------------------------------------------------------------
# OPSIONAL
# --------------------------------------------------------------
# Default true (AMAN). Memaksa inject "stream_options.include_usage=true"
# pada request streaming agar objek usage ikut terkirim di chunk terakhir —
# ini yang membuat token streaming tetap terhitung dan tidak "bocor" dari kuota.
#
# Set "false" HANYA bila provider/muat-anda menolak field stream_options
# (beberapa endpoint non-OpenAI membalas 400). Risikonya: bila provider TIDAK
# mengirim usage pada stream, token request streaming tidak akan terhitung.
INJECT_STREAM_USAGE=true

# --------------------------------------------------------------
# TOKO PEMBELIAN (QRIS DANA OTOMATIS) — OPSIONAL
# --------------------------------------------------------------
# URL publik toko, dipakai untuk tautan di notifikasi WA/email pembeli
# (Base URL API + link dashboard member). Contoh: https://llm.thormarket.site
# Bila kosong, pesan otomatis memakai domain produksi bawaan
# https://llm.thormarket.site (lihat DOMAIN_BAWAAN di src/lib/notify.js).
# Catatan: string QRIS statis, secret webhook, token Fonnte, dan API key
# Resend TIDAK di sini — semuanya diatur dari Panel Admin (/admin),
# tab "Toko & Pesanan", tersimpan di database.
#PUBLIC_BASE_URL=https://llm.thormarket.site
