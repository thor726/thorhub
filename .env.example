# ==============================================================
# LLM PROXY GATEWAY - KONFIGURASI
# Salin file ini menjadi ".env" lalu isi nilainya:
#   cp .env.example .env
# ==============================================================

# Port server gateway
PORT=3000

# Master API Key yang dipakai GATEWAY untuk memanggil provider utama.
# JANGAN pernah dibagikan ke pembeli!
MASTER_API_KEY=sk-master-GANTI-DENGAN-KEY-ASLI-ANDA

# Base URL provider utama (tanpa trailing slash).
# Contoh OpenAI     : https://api.openai.com/v1
# Contoh OpenRouter : https://openrouter.ai/api/v1
# Contoh provider lain sesuaikan dengan dokumentasinya.
TARGET_API_BASE_URL=https://api.openai.com/v1

# API Key admin untuk mengakses endpoint manajemen /admin/*
ADMIN_API_KEY=admin-GANTI-SECRET-INI

# Timeout antrean: pembeli menunggu giliran maksimal selama ini (ms)
QUEUE_WAIT_TIMEOUT_MS=60000

# Timeout request ke provider utama (ms)
UPSTREAM_TIMEOUT_MS=120000

# Opsional (default false): paksa inject "stream_options.include_usage=true"
# pada request streaming agar usage token tetap terhitung di chunk terakhir.
# Hati-hati: beberapa provider non-OpenAI bisa menolak field ini.
INJECT_STREAM_USAGE=false
