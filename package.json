{
  "name": "thorhub-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Workspace monorepo: kumpulan project mandiri di dalam apps/. Kode aplikasi TIDAK ditaruh di root.",
  "workspaces": [],
  "scripts": {
    "app:baru": "bash scripts/app-baru.sh",
    "app:daftar": "bash scripts/daftar-app.sh",
    "install:semua": "bash scripts/install-semua.sh",
    "gateway": "npm --prefix apps/llm-gateway run dev",
    "gateway:start": "npm --prefix apps/llm-gateway start",
    "test": "npm --prefix apps/llm-gateway test",
    "test:semua": "bash scripts/test-semua.sh"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
